# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase Dashboard -> Project Settings -> API).

# Public values (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Public base URL of this app. Used for email links (confirm / password reset).
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SECRET - server-side only. Never prefix with NEXT_PUBLIC_ and never commit.
# Used by scripts/create-privileged-user.mjs and, on the server only, by the
# appointment reminder job and the UniSMS webhook.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SECRET - UniSMS. Server only. Do not prefix with NEXT_PUBLIC_.
UNISMS_API_SECRET_KEY=
UNISMS_SENDER_ID=
UNISMS_WEBHOOK_SECRET_KEY=

# SECRET - required by Vercel Cron. Vercel sends Authorization: Bearer CRON_SECRET.
CRON_SECRET=
